# Wallet production environment (copy to .env on the server and fill the blanks).
# Never commit the real .env. Every value below must be set deliberately.

APP_NAME=Wallet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wallet.example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MariaDB 10.6+ (or MySQL 8). Use a wallet-only account and an encrypted connection
# (SSL) or a private network / localhost. Never an open, unencrypted internet connection.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem

# Sessions: server-side, encrypted, HTTPS-only cookies.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Real email is required: verification and password-reset emails are sent through it.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@wallet.example.com
MAIL_FROM_NAME="${APP_NAME}"

# Set when the app is behind a load balancer or reverse proxy (comma separated IPs, or * for all).
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12
